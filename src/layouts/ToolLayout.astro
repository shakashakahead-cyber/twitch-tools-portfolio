---
import Layout from './Layout.astro';

// 記事（Markdown）のヘッダー情報を受け取る型定義
interface Props {
  frontmatter: {
    title: string;
    description: string;
    icon: string;
    storeUrl: string;
    videoId?: string; // 動画IDは任意（なければ表示しない）
    privacyUrl: string;
  }
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | 暁左衛門 Lab`} description={frontmatter.description}>
  <div class="bg-slate-900 min-h-screen pt-24 pb-16">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      
      <a href="/" class="inline-flex items-center text-sm text-gray-400 hover:text-white mb-8 transition-colors">
        <span aria-hidden="true">&larr;</span> ツール一覧に戻る
      </a>

      <div class="text-center mb-16">
        <div class="text-6xl mb-4">{frontmatter.icon}</div>
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-5xl mb-6">
          {frontmatter.title}
        </h1>
        <p class="text-lg leading-8 text-gray-300 max-w-2xl mx-auto">
          {frontmatter.description}
        </p>
        
        <div class="mt-8 flex justify-center gap-4">
          <a href={frontmatter.storeUrl} target="_blank" class="rounded-md bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all">
            Chrome Web Storeで追加
          </a>
        </div>
      </div>

      {frontmatter.videoId && (
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
            <span>📺</span> 使い方・紹介動画
          </h2>
          <div class="aspect-video rounded-xl overflow-hidden bg-black shadow-2xl ring-1 ring-white/10">
            <iframe 
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${frontmatter.videoId}`}
              title="YouTube video player" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen>
            </iframe>
          </div>
        </div>
      )}

      <article class="prose prose-invert prose-lg max-w-none bg-slate-800/50 p-8 rounded-2xl ring-1 ring-white/10">
        <slot />
      </article>

      <div class="mt-12 border-t border-white/10 pt-8 flex justify-center gap-6 text-sm">
         <a href={frontmatter.privacyUrl} class="text-gray-400 hover:text-white">プライバシーポリシー</a>
         <span class="text-gray-600">|</span>
         <a href="https://x.com/akatsukizaemon" target="_blank" class="text-gray-400 hover:text-white">開発者に連絡 (X)</a>
      </div>

    </div>
  </div>
</Layout>
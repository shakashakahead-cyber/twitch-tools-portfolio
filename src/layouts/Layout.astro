---
interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image = "/images/avatar.png" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.url);
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />

        <!-- OGP Tags -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:site_name" content="Akatsukizaemon Lab" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@akatsukizaemon" />
        <meta name="twitter:creator" content="@akatsukizaemon" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-slate-900 text-slate-100 font-sans antialiased selection:bg-purple-500 selection:text-white"
    >
        <div
            class:list={[
                {
                    "markdown-container prose prose-invert prose-lg":
                        Astro.url.pathname.startsWith("/privacy/"),
                },
            ]}
        >
            <slot />
        </div>
    </body>
</html>

<style is:global>
    body {
        font-family: "Noto Sans JP", sans-serif;
    }

    /* Markdownページ用のスタイル */
    /* @tailwindcss/typography プラグインを使用するため手動定義は削除 */

    /* Markdownページのコンテナ */
    .markdown-container {
        @apply mx-auto max-w-3xl px-6 py-24;
    }
</style>

---
interface Props {
    title?: string;
    description?: string;
    image?: string;
    frontmatter?: {
        title: string;
        description: string;
        image?: string;
        privacyUrl?: string;
    };
}

import { getLangFromUrl } from "../i18n/utils";
import Footer from "../components/Footer.astro";
import { socialLinks } from "../data/siteData";

const lang = getLangFromUrl(Astro.url);
const { frontmatter } = Astro.props;
const title = Astro.props.title || frontmatter?.title || "Akatsukizaemon Lab";
const defaultDescription =
    lang === "en"
        ? "Streamer tools and notes by Akatsukizaemon"
        : "配信の悩みを技術で解決するツール集です。";
const description =
    Astro.props.description ||
    frontmatter?.description ||
    defaultDescription;
const image = Astro.props.image || frontmatter?.image || "/images/avatar.png";
const pathname = Astro.url.pathname;
// 正規化: index.html を削除し、末尾に必ずスラッシュをつける
const cleanPath = pathname.replace(/\/index\.html$/, "");
const finalPath = cleanPath.endsWith("/") ? cleanPath : `${cleanPath}/`;
const canonicalURL = new URL(finalPath, Astro.site);

const socialImageURL = new URL(image, Astro.url);
const schemaDescription = defaultDescription;

// ベースパスの計算（言語プレフィックスを除外）
const basePath = pathname.startsWith("/en/")
    ? pathname.replace("/en/", "/")
    : pathname;
const isTranslatedPath =
    basePath === "/" ||
    basePath === "/about/" ||
    (basePath.startsWith("/tools/") && !basePath.startsWith("/tools/ichi-browser"));
const jaURL = new URL(basePath, Astro.site);
const enURL = new URL(`/en${basePath === "/" ? "/" : basePath}`, Astro.site);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <!-- Google tag (gtag.js) -->
        <script is:inline>
            const isProductionAnalyticsHost =
                window.location.hostname === "shakashakahead.com";
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            if (isProductionAnalyticsHost) {
                gtag("js", new Date());
                gtag("config", "G-411RHL1DTK");

                const googleTag = document.createElement("script");
                googleTag.async = true;
                googleTag.src = "https://www.googletagmanager.com/gtag/js?id=G-411RHL1DTK";
                document.head.appendChild(googleTag);
            }
        </script>
        <script is:inline>
            function getToolDownloadTracking(href) {
                try {
                    const url = new URL(href, window.location.href);
                    const path = url.pathname.toLowerCase();

                    if (url.hostname === "chromewebstore.google.com") {
                        if (path.includes("fonjapihhkafhmjfdpdcgfoghngldmep")) {
                            return {
                                toolName: "twitch_stream_helper",
                                destination: "chrome_web_store",
                            };
                        }

                        if (path.includes("eolabmdepbcdcppfdmkibgjffiifndkd")) {
                            return {
                                toolName: "comment_reader",
                                destination: "chrome_web_store",
                            };
                        }
                    }

                    if (url.hostname === "github.com") {
                        // Release-page visits may be for source or license checks.
                        // Keep them separate from direct EXE/APK clicks.
                        if (path.replace(/\/$/, "") === "/shakashakahead-cyber/twitch-stream-helper/releases/latest") {
                            return {
                                toolName: "twitch_stream_helper",
                                destination: "github_release_page",
                            };
                        }

                        if (/^\/shakashakahead-cyber\/twitch-tools-portfolio\/releases\/tag\/ichi-[^/]+\/?$/.test(path)) {
                            return {
                                toolName: "ichi_browser",
                                destination: "github_release_page",
                            };
                        }

                        if (
                            path.includes("/shakashakahead-cyber/clip-extractor/releases/download/") &&
                            path.endsWith(".exe")
                        ) {
                            return {
                                toolName: "clip_extractor",
                                destination: "github_release",
                            };
                        }

                        if (
                            path.includes("/shakashakahead-cyber/twitch-tools-portfolio/releases/download/ichi-") &&
                            path.endsWith(".apk")
                        ) {
                            return {
                                toolName: "ichi_browser",
                                destination: "github_release",
                            };
                        }
                    }
                } catch {
                    return null;
                }

                return null;
            }

            function trackToolDownloadClick(event) {
                if (!isProductionAnalyticsHost) return;
                if (event.type === "auxclick" && event.button !== 1) return;
                if (event.type === "click" && event.button !== 0) return;
                const target = event.target;
                if (!(target instanceof Element)) return;

                const link = target.closest("a[href]");
                if (!(link instanceof HTMLAnchorElement)) return;

                const tracking = getToolDownloadTracking(link.href);
                if (!tracking || typeof gtag !== "function") return;

                gtag("event", "tool_download_click", {
                    tool_name: tracking.toolName,
                    destination: tracking.destination,
                    link_url: link.href,
                });
            }

            document.addEventListener("click", trackToolDownloadClick);
            document.addEventListener("auxclick", trackToolDownloadClick);
        </script>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />
        {
            isTranslatedPath && (
                <>
                    <link rel="alternate" hreflang="ja" href={jaURL} />
                    <link rel="alternate" hreflang="en" href={enURL} />
                    <link rel="alternate" hreflang="x-default" href={jaURL} />
                </>
            )
        }

        <!-- OGP Tags -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:site_name" content="Akatsukizaemon Lab" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@akatsukizaemon" />
        <meta name="twitter:creator" content="@akatsukizaemon" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-slate-900 text-slate-100 font-sans antialiased selection:bg-purple-500 selection:text-white"
    >
        <div
            class:list={[
                {
                    "markdown-container prose prose-invert prose-lg":
                        Astro.url.pathname.startsWith("/privacy/") ||
                        Astro.url.pathname.startsWith("/support") ||
                        Astro.url.pathname.startsWith("/start") ||
                        Astro.url.pathname.startsWith("/faq"),
                },
            ]}
        >
            <slot />
        </div>
        <Footer socialLinks={socialLinks} privacyUrl={frontmatter?.privacyUrl} />
    </body>
</html>

<style is:global>
    body {
        font-family: "Noto Sans JP", sans-serif;
    }

    /* Markdownページ用のスタイル */
    /* @tailwindcss/typography プラグインを使用するため手動定義は削除 */

    /* Markdownページのコンテナ */
    .markdown-container {
        @apply mx-auto max-w-3xl px-6 py-24;
    }

    /* テーマ用変数 */
    :root {
        --color-main: #5e81ac;
        --color-accent: #88c0d0;
        --color-bg: #0f172a;
        --color-text: #e2e8f0;
    }
</style>

<script
    type="application/ld+json"
    set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Akatsukizaemon Lab",
        url: "https://shakashakahead.com/",
        description: schemaDescription,
    })}
></script>

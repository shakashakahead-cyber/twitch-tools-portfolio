---
interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image = "/images/avatar.png" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.url);

import { getLangFromUrl } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />

        <!-- OGP Tags -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:site_name" content="Akatsukizaemon Lab" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@akatsukizaemon" />
        <meta name="twitter:creator" content="@akatsukizaemon" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-slate-900 text-slate-100 font-sans antialiased selection:bg-purple-500 selection:text-white"
    >
        <div
            class:list={[
                {
                    "markdown-container prose prose-invert prose-lg":
                        Astro.url.pathname.startsWith("/privacy/"),
                },
            ]}
        >
            <slot />
        </div>
    </body>
</html>

<style is:global>
    body {
        font-family: "Noto Sans JP", sans-serif;
    }

    /* Markdownページ用のスタイル */
    /* @tailwindcss/typography プラグインを使用するため手動定義は削除 */

    /* Markdownページのコンテナ */
    .markdown-container {
        @apply mx-auto max-w-3xl px-6 py-24;
    }

    /* テーマ用変数 */
    :root {
        --color-main: #5e81ac;
        --color-accent: #88c0d0;
        --color-bg: #0f172a;
        --color-text: #e2e8f0;
    }
</style>

<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Akatsukizaemon Lab",
        "url": "https://shakashakahead.com/",
        "potentialAction": {
            "@type": "SearchAction",
            "target": "https://shakashakahead.com/?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
</script>

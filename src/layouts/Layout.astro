---
interface Props {
    title?: string;
    description?: string;
    image?: string;
    frontmatter?: {
        title: string;
        description: string;
        image?: string;
    };
}

const { frontmatter } = Astro.props;
const title = Astro.props.title || frontmatter?.title || "Akatsukizaemon Lab";
const description = Astro.props.description || frontmatter?.description || "Portfolio and tools by Akatsukizaemon";
const image = Astro.props.image || frontmatter?.image || "/images/avatar.png";
const pathname = Astro.url.pathname;
// 正規化: index.html を削除し、末尾に必ずスラッシュをつける
const cleanPath = pathname.replace(/\/index\.html$/, "");
const finalPath = cleanPath.endsWith("/") ? cleanPath : `${cleanPath}/`;
const canonicalURL = new URL(finalPath, Astro.site);

const socialImageURL = new URL(image, Astro.url);

import { getLangFromUrl } from "../i18n/utils";
import Footer from "../components/Footer.astro";
import { socialLinks } from "../data/siteData";
const lang = getLangFromUrl(Astro.url);

// ベースパスの計算（言語プレフィックスを除外）
const basePath = pathname.startsWith("/en/")
    ? pathname.replace("/en/", "/")
    : pathname;
const isTranslatedPath =
    basePath === "/" ||
    basePath === "/about/" ||
    basePath.startsWith("/tools/");
const jaURL = new URL(basePath, Astro.site);
const enURL = new URL(`/en${basePath === "/" ? "/" : basePath}`, Astro.site);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />
        {
            isTranslatedPath && (
                <>
                    <link rel="alternate" hreflang="ja" href={jaURL} />
                    <link rel="alternate" hreflang="en" href={enURL} />
                    <link rel="alternate" hreflang="x-default" href={jaURL} />
                </>
            )
        }

        <!-- OGP Tags -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:site_name" content="Akatsukizaemon Lab" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@akatsukizaemon" />
        <meta name="twitter:creator" content="@akatsukizaemon" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-slate-900 text-slate-100 font-sans antialiased selection:bg-purple-500 selection:text-white"
    >
        <div
            class:list={[
                {
                    "markdown-container prose prose-invert prose-lg":
                        Astro.url.pathname.startsWith("/privacy/") ||
                        Astro.url.pathname.startsWith("/support") ||
                        Astro.url.pathname.startsWith("/start") ||
                        Astro.url.pathname.startsWith("/faq"),
                },
            ]}
        >
            <slot />
        </div>
        <Footer socialLinks={socialLinks} privacyUrl={frontmatter?.privacyUrl} />
    </body>
</html>

<style is:global>
    body {
        font-family: "Noto Sans JP", sans-serif;
    }

    /* Markdownページ用のスタイル */
    /* @tailwindcss/typography プラグインを使用するため手動定義は削除 */

    /* Markdownページのコンテナ */
    .markdown-container {
        @apply mx-auto max-w-3xl px-6 py-24;
    }

    /* テーマ用変数 */
    :root {
        --color-main: #5e81ac;
        --color-accent: #88c0d0;
        --color-bg: #0f172a;
        --color-text: #e2e8f0;
    }
</style>

<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Akatsukizaemon Lab",
        "url": "https://shakashakahead.com/"
    }
</script>

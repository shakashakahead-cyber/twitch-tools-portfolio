---
import Layout from "./Layout.astro";

// 記事（Markdown）のヘッダー情報を受け取る型定義
interface Props {
    frontmatter: {
        title: string;
        description: string;
        icon: string;
        image: string;
        downloadUrl: string;
        fileSize?: string;
        version?: string;
        repoUrl?: string;
        videoId?: string;
        uploadDate?: string;
        privacyUrl?: string;
        requirements?: string[];
        faq?: {
            question: string;
            answer: string;
        }[];
        tags?: string[];
    };
}

const { frontmatter } = Astro.props;

import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeLink = lang === "en" ? "/en/" : "/";

// 他のツールを取得（自分以外）
const allTools = await Astro.glob("../pages/tools/*.md");
const relatedTools = allTools.filter(
    (tool) => tool.url && !Astro.url.pathname.endsWith(tool.url),
);

// 関連するブログ記事を取得
const allPosts = await Astro.glob("../pages/blog/*.md");
const relatedPosts = allPosts.filter((post) => {
    // ツールにタグがない、または記事にタグがない場合は除外
    if (!frontmatter.tags || !post.frontmatter.tags) return false;
    // 共通のタグがあるかチェック
    const hasCommonTag = frontmatter.tags.some((tag: string) =>
        post.frontmatter.tags.includes(tag)
    );
    return hasCommonTag;
});

// ▼▼▼ 構造化データ（JSON-LD）の定義 ▼▼▼
const baseSchema = {
    "@type": "SoftwareApplication",
    name: frontmatter.title,
    description: frontmatter.description,
    operatingSystem: "Windows",
    applicationCategory: "DesktopEnhancement",
    offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "JPY",
    },
    author: {
        "@type": "Person",
        name: "Akatsukizaemon",
        url: "https://shakashakahead.com",
    },
    ...(frontmatter.repoUrl && { codeRepository: frontmatter.repoUrl }),
};

// 動画スキーマ（独立したVideoObjectとして定義）
const videoSchema = frontmatter.videoId
    ? {
          "@type": "VideoObject",
          "@id": `https://shakashakahead.com${Astro.url.pathname}#video`,
          name: `${frontmatter.title} ${t("schema.video.title_suffix")}`,
          description: t("schema.video.description"),
          thumbnailUrl: `https://img.youtube.com/vi/${frontmatter.videoId}/maxresdefault.jpg`,
          uploadDate: frontmatter.uploadDate,
          contentUrl: `https://www.youtube.com/watch?v=${frontmatter.videoId}`,
          embedUrl: `https://www.youtube.com/embed/${frontmatter.videoId}`,
      }
    : null;

// FAQスキーマがある場合
const faqSchema =
    frontmatter.faq && frontmatter.faq.length > 0
        ? {
              "@type": "FAQPage",
              mainEntity: frontmatter.faq.map((item) => ({
                  "@type": "Question",
                  name: item.question,
                  acceptedAnswer: {
                      "@type": "Answer",
                      text: item.answer,
                  },
              })),
          }
        : null;

// Graph形式で複数のスキーマを結合
const schemaData = {
    "@context": "https://schema.org",
    "@graph": [baseSchema, ...(videoSchema ? [videoSchema] : []), ...(faqSchema ? [faqSchema] : [])],
};
// ▲▲▲ 定義ここまで ▲▲▲
---

<Layout
    title={`${frontmatter.title} | 暁左衛門 Lab`}
    description={frontmatter.description}
    image={frontmatter.image}
>
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    <div class="bg-slate-900 min-h-screen pt-24 pb-32">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <a
                href={homeLink}
                class="inline-flex items-center text-sm text-gray-400 hover:text-white mb-8 transition-colors"
            >
                <span aria-hidden="true">&larr;</span>
                {t("nav.home")}
            </a>

            <div class="text-center mb-16">
                <div class="text-6xl mb-4">{frontmatter.icon}</div>
                <h1
                    class="text-3xl font-bold tracking-tight text-white sm:text-5xl mb-6"
                >
                    {frontmatter.title}
                </h1>
                <p
                    class="text-lg leading-8 text-gray-300 max-w-2xl mx-auto mb-4"
                >
                    {frontmatter.description}
                </p>

                <!-- バッジ類 -->
                <div class="flex items-center justify-center gap-3 mb-8">
                    <span
                        class="inline-flex items-center gap-1.5 bg-slate-800 text-gray-300 text-sm px-3 py-1.5 rounded-full ring-1 ring-white/10"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path
                                d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"
                            ></path>
                        </svg>
                        Windows専用
                    </span>
                    {
                        frontmatter.version && (
                            <span class="inline-flex items-center gap-1.5 bg-indigo-500/20 text-indigo-300 text-sm px-3 py-1.5 rounded-full ring-1 ring-indigo-500/30">
                                v{frontmatter.version}
                            </span>
                        )
                    }
                    {
                        frontmatter.fileSize && (
                            <span class="inline-flex items-center gap-1.5 bg-slate-800 text-gray-300 text-sm px-3 py-1.5 rounded-full ring-1 ring-white/10">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="1.5"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                                    />
                                </svg>
                                {frontmatter.fileSize}
                            </span>
                        )
                    }
                </div>

                <div class="flex justify-center gap-4">
                    <a
                        href={frontmatter.downloadUrl}
                        target="_blank"
                        class="rounded-md bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-3.5 text-base font-bold text-white shadow-lg hover:from-indigo-500 hover:to-purple-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all flex items-center gap-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
                            ></path>
                        </svg>
                        {t("btn.download")}
                    </a>
                    {
                        frontmatter.repoUrl && (
                            <a
                                href={frontmatter.repoUrl}
                                target="_blank"
                                class="rounded-md bg-white/10 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 transition-all"
                            >
                                {t("btn.github")}
                            </a>
                        )
                    }
                </div>
            </div>

            <!-- スクリーンショット -->
            {
                frontmatter.image && (
                    <div class="mb-16">
                        <div class="rounded-xl overflow-hidden bg-slate-800 shadow-2xl ring-1 ring-white/10">
                            <img
                                src={frontmatter.image}
                                alt={frontmatter.title}
                                class="w-full h-auto"
                            />
                        </div>
                    </div>
                )
            }

            {
                frontmatter.videoId && (
                    <div class="mb-16">
                        <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
                            <span>📺</span> {t("header.video")}
                        </h2>
                        <div class="aspect-video rounded-xl overflow-hidden bg-black shadow-2xl ring-1 ring-white/10">
                            <iframe
                                class="w-full h-full"
                                src={`https://www.youtube.com/embed/${frontmatter.videoId}`}
                                title="YouTube video player"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen
                            />
                        </div>
                    </div>
                )
            }

            <article
                class="prose prose-invert prose-lg max-w-none bg-slate-800/50 p-8 rounded-2xl ring-1 ring-white/10"
            >
                <slot />
            </article>

            {/* FAQ Section */}
            {
                frontmatter.faq && frontmatter.faq.length > 0 && (
                    <div class="mt-16">
                        <h2 class="text-2xl font-bold text-white mb-8 flex items-center gap-2">
                            <span>❓</span> {t("section.faq")}
                        </h2>
                        <dl class="space-y-8">
                            {frontmatter.faq.map((item) => (
                                <div class="bg-slate-800/30 rounded-xl p-6 ring-1 ring-white/5">
                                    <dt class="text-lg font-semibold leading-7 text-white flex gap-3">
                                        <span class="text-indigo-400">Q.</span>
                                        {item.question}
                                    </dt>
                                    <dd class="mt-2 text-base leading-7 text-gray-300 pl-7">
                                        <span class="font-bold text-gray-500 mr-2">
                                            A.
                                        </span>
                                        {item.answer}
                                    </dd>
                                </div>
                            ))}
                        </dl>
                    </div>
                )
            }

            {/* Related Posts Section */}
            {
                relatedPosts.length > 0 && (
                <div class="mt-24 border-t border-white/10 pt-16">
                    <h2 class="text-2xl font-bold text-white mb-8 flex items-center gap-2">
                    <span>📚</span> {t("section.related_posts") || "Related Articles"}
                    </h2>
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    {relatedPosts.map((post) => (
                        <a
                        href={post.url}
                        class="group relative flex flex-col gap-2 rounded-xl bg-slate-800/50 p-6 hover:bg-slate-800 transitions-colors ring-1 ring-white/10 hover:ring-indigo-500/50"
                        >
                        <div class="flex items-center gap-2 text-xs text-indigo-400 mb-2">
                            <span>{new Date(post.frontmatter.pubDate).toLocaleDateString("ja-JP")}</span>
                            {post.frontmatter.tags && post.frontmatter.tags.map(tag => (
                            <span class="bg-indigo-500/10 px-2 py-0.5 rounded-full">{tag}</span>
                            ))}
                        </div>
                        <h3 class="text-lg font-semibold text-white group-hover:text-indigo-300 transition-colors">
                            {post.frontmatter.title}
                        </h3>
                        <p class="text-sm text-gray-400 line-clamp-2">
                            {post.frontmatter.description}
                        </p>
                        </a>
                    ))}
                    </div>
                </div>
                )
            }

            {/* Related Tools Section */}
            {
                relatedTools.length > 0 && (
                    <div class="mt-24 border-t border-white/10 pt-16">
                        <h2 class="text-2xl font-bold text-white mb-8">
                            {t("section.related_tools")}
                        </h2>
                        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                            {relatedTools.map((tool) => (
                                <a
                                    href={tool.url}
                                    class="relative flex items-center gap-4 rounded-xl bg-slate-800/50 p-6 hover:bg-slate-800 transitions-colors ring-1 ring-white/10 hover:ring-indigo-500/50 group"
                                >
                                    <div class="text-4xl group-hover:scale-110 transition-transform duration-300">
                                        {tool.frontmatter.icon}
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-semibold text-white">
                                            {tool.frontmatter.title}
                                        </h3>
                                        <p class="text-sm text-gray-400 line-clamp-1">
                                            {tool.frontmatter.description}
                                        </p>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }
        </div>
    </div>

    {/* Sticky CTA (Mobile/Tablet) */}
    <div
        class="fixed bottom-0 left-0 right-0 p-4 bg-slate-900/90 backdrop-blur-md border-t border-white/10 md:hidden z-50"
    >
        <a
            href={frontmatter.downloadUrl}
            target="_blank"
            class="block w-full text-center rounded-md bg-gradient-to-r from-indigo-600 to-purple-600 px-5 py-3 text-base font-bold text-white shadow-lg hover:from-indigo-500 hover:to-purple-500 transition-all flex items-center justify-center gap-2"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-5 h-5"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
                ></path>
            </svg>
            {t("btn.download")}
        </a>
    </div>
</Layout>

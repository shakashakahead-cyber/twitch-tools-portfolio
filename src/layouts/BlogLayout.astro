---
import Layout from "./Layout.astro";
import Navigation from "../components/Navigation.astro";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
    frontmatter: {
        title: string;
        description: string;
        pubDate: string;
        image?: string;
    };
}

const { frontmatter } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const disclosureTitle = lang === "en" ? "Affiliate Disclosure" : "アフィリエイト開示";
const affiliateDisclosure =
    lang === "en"
        ? "This article may contain affiliate links. If you buy through them, I may earn a commission."
        : "この記事にはアフィリエイトリンクが含まれる場合があります。リンク経由で購入されると、紹介料を受け取ることがあります。";
const amazonDisclosure =
    lang === "en"
        ? "As an Amazon Associate I earn from qualifying purchases."
        : "当サイトは Amazon アソシエイトとして、適格販売により収入を得ています。";

const socialLinks = {
    twitch: "https://www.twitch.tv/akatsukizaemon",
    x: "https://x.com/akatsukizaemon",
    email: "shakashakahead@gmail.com",
};
---

<Layout
    title={`${frontmatter.title} | 暁左衛門 Lab Blog`}
    description={frontmatter.description}
    image={frontmatter.image}
>
    <Navigation />

    <main class="pt-24 pb-16 lg:pt-32 lg:pb-24 bg-slate-900 min-h-screen">
        <div class="mx-auto max-w-3xl px-6 lg:px-8">
            <div class="mb-10 text-center">
                <time
                    datetime={frontmatter.pubDate}
                    class="text-indigo-400 font-mono text-sm mb-2 block"
                >
                    {new Date(frontmatter.pubDate).toLocaleDateString("ja-JP")}
                </time>
                <h1
                    class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
                >
                    {frontmatter.title}
                </h1>
            </div>

            <article
                class="prose prose-invert prose-lg max-w-none prose-strong:font-bold prose-strong:text-white"
            >
                <div class="mb-8 rounded-lg border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-100">
                    <p class="font-semibold text-amber-200">{disclosureTitle}</p>
                    <p class="mt-1">{affiliateDisclosure}</p>
                    <p class="mt-1 text-amber-200/90">{amazonDisclosure}</p>
                </div>
                <slot />

                <div
                    class="mt-12 bg-indigo-500/10 border border-indigo-500/20 rounded-lg p-4"
                >
                    <p class="text-sm text-gray-300">
                        👉 2つのツールを一覧で見たい方は、<a
                            href="/tools/"
                            class="text-indigo-400 font-bold hover:underline"
                            >ツール一覧ページ</a
                        > もどうぞ。
                    </p>
                </div>
            </article>

            <div
                class="mt-16 pt-8 border-t border-white/10 flex justify-between items-center"
            >
                <a
                    href="/blog/"
                    class="text-sm font-semibold text-indigo-400 hover:text-indigo-300"
                >
                    ← ブログ一覧に戻る
                </a>
            </div>
        </div>
    </main>


</Layout>

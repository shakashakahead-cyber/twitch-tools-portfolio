---
import { ui, defaultLang } from "../i18n/ui";

const url = Astro.url;
const currentLang = url.pathname.startsWith("/en") ? "en" : "ja";
const t = ui[currentLang];

const homePath = currentLang === "en" ? "/en/" : "/";
const toolsPath = currentLang === "en" ? "/en/tools/" : "/tools/";
const blogPath = "/blog/"; // ブログは現状日本語のみ想定だが、構造上分けておく
const aboutPath = currentLang === "en" ? "/en/about/" : "/about/";

const links = [
    { name: t["nav.home"], href: homePath },
    { name: t["nav.tools"], href: toolsPath },
    { name: t["nav.blog"], href: blogPath },
    { name: t["nav.about"], href: aboutPath },
];
---

<header class="absolute inset-x-0 top-0 z-50">
    <nav
        class="flex items-center justify-between p-6 lg:px-8"
        aria-label="Global"
    >
        <div class="flex lg:flex-1">
            <a
                href="/"
                class="-m-1.5 p-1.5 text-white font-bold text-lg hover:text-indigo-400 transition-colors"
            >
                暁左衛門 Lab
            </a>
        </div>
        <div class="flex gap-x-12">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="text-sm font-semibold leading-6 text-white hover:text-indigo-300 transition-colors"
                    >
                        {link.name}
                    </a>
                ))
            }
        </div>
        <div class="hidden lg:flex lg:flex-1 lg:justify-end">
            <!-- 将来的にLoginなどを置くスペース -->
        </div>
    </nav>
</header>

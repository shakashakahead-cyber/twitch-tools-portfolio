---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
    socialLinks: {
        twitch: string;
        x: string;
        email: string;
    };
}

const { socialLinks } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="bg-slate-900 py-16 sm:py-24 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
            {t("contact.title")}
        </h2>
        <p class="mt-4 text-gray-300" set:html={t("contact.desc")} />
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
            <a
                href={socialLinks.x}
                target="_blank"
                class="rounded-full bg-black px-6 py-3 text-sm font-semibold text-white shadow-sm ring-1 ring-white/20 hover:bg-gray-800 transition-all flex items-center justify-center gap-2"
            >
                <svg
                    class="h-4 w-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    ><path
                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path></svg
                >
                {t("contact.x")}
            </a>
            <a
                href={`mailto:${socialLinks.email}`}
                class="rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-white hover:bg-white/20 transition-all flex items-center justify-center gap-2"
            >
                <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                    ></path>
                </svg>
                {t("contact.email")}
            </a>
        </div>
    </div>
</section>

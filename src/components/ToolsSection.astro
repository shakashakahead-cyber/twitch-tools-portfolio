---
import ToolCard from "./ToolCard.astro";

interface Tool {
    title: string;
    desc: string;
    link: string;
    storeUrl: string;
    icon: string;
    image: string;
    repoUrl?: string;
    features?: string[];
    isFree?: boolean;
    badge?: string;
    recommend?: string;
}

interface Props {
    extensions: Tool[];
}

const { extensions } = Astro.props;
---

<section id="products" class="bg-slate-800/50 py-24 sm:py-32 relative z-10">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
            <h2
                class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
            >
                Developed Extensions
            </h2>
        </div>
        <div
            class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-2"
        >
            {extensions.map((ext) => <ToolCard {...ext} />)}
        </div>
    </div>
</section>

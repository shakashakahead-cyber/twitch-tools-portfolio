---
interface Props {
    title: string;
    desc: string;
    image: string;
    link: string;
    icon: string;
    storeUrl: string;
    repoUrl?: string;
    features?: string[];
    isFree?: boolean;
    badge?: string;
    recommend?: string;
}

const {
    title,
    desc,
    image,
    link,
    icon,
    storeUrl,
    repoUrl,
    features = [],
    isFree = false,
    badge,
    recommend,
} = Astro.props;
import { ui } from "../i18n/ui";

const currentLang = link.startsWith("/en") ? "en" : "ja";
const t = ui[currentLang];
---

<div
    class="group relative flex flex-col overflow-hidden rounded-2xl bg-slate-900 shadow-xl ring-1 ring-white/10 transition-all hover:ring-indigo-500 hover:-translate-y-1"
>
    <!-- Card Link Wrapper to make header clickable -->
    <a href={link} class="absolute inset-x-0 top-0 h-64 z-10" aria-label={title}
    ></a>

    <div class="relative h-64 overflow-hidden bg-slate-800 block">
        <img
            src={image}
            alt={title}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100"
        />
        <div
            class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent"
        >
        </div>

        {
            isFree && (
                <div class="absolute top-4 right-4 bg-green-500/90 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg backdrop-blur-sm z-20">
                    {currentLang === "en" ? "Free to use" : "無料で利用可能"}
                </div>
            )
        }
    </div>

    <div class="p-6 flex flex-col flex-1 relative z-20 pointer-events-none">
        <div
            class="flex items-start justify-between gap-4 mb-2 pointer-events-auto"
        >
            <a
                href={link}
                class="flex items-center gap-x-3 text-xl font-bold text-white group-hover:text-indigo-400 transition-colors"
            >
                <span>{icon}</span>
                {title}
            </a>
        </div>

        {
            badge && (
                <div class="mb-3">
                    <span class="inline-block bg-indigo-500 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">
                        {badge}
                    </span>
                </div>
            )
        }

        <p class="text-sm text-gray-400 line-clamp-2 mb-4">
            {desc}
        </p>

        {
            recommend && (
                <div class="mb-4 bg-indigo-500/10 border border-indigo-500/20 rounded p-3">
                    <p class="text-xs text-indigo-300 font-bold mb-1">
                        {currentLang === "en"
                            ? "Recommended for:"
                            : "こんな方に："}
                    </p>
                    <p class="text-xs text-gray-300">{recommend}</p>
                </div>
            )
        }

        {
            features.length > 0 && (
                <ul class="mb-6 space-y-1">
                    {features.slice(0, 3).map((feature) => (
                        <li class="text-xs text-gray-400 flex items-start gap-2">
                            <span class="text-indigo-500 mt-0.5">•</span>
                            {feature}
                        </li>
                    ))}
                </ul>
            )
        }

        <div
            class="mt-auto flex items-center justify-between pointer-events-auto pt-4 border-t border-white/5"
        >
            <a
                href={link}
                class="text-sm font-semibold text-indigo-400 hover:text-indigo-300 flex items-center gap-1"
            >
                {currentLang === "en" ? "View Details" : "詳細を見る"}
                <span aria-hidden="true">&rarr;</span>
            </a>
            <div class="flex items-center gap-2">
                {
                    repoUrl && (
                        <a
                            href={repoUrl}
                            target="_blank"
                            class="text-xs font-semibold text-gray-300 hover:text-white transition-colors"
                        >
                            {t["btn.github"]}
                        </a>
                    )
                }
                <a
                    href={storeUrl}
                    target="_blank"
                    class="rounded-md bg-white/10 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 transition-colors flex items-center gap-2"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-4 h-4 text-indigo-400"
                    >
                        <path
                            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                        ></path>
                    </svg>
                    {t["btn.store"]}
                </a>
            </div>
        </div>
    </div>
</div>

---
const updates = [
    {
        date: "2025.12.12",
        content: "VOICEVOXキャラクター利用規約まとめ記事を公開しました。",
        link: "/blog/voicevox-terms-summary/",
        type: "blog",
    },
    {
        date: "2025.12.09",
        content: "ブログを開設し、拡張機能紹介記事を公開しました。",
        link: "/blog/introducing-my-tools/",
        type: "blog",
    },
    {
        date: "2025.12.08",
        content:
            "「Comment Reader for Twitch (powered by Voicevox)」へ名称を変更しました。",
        link: "/tools/voicevox-comment-reader/",
    },
    {
        date: "2025.12.09",
        content: "ポートフォリオサイトをリニューアルしました",
    },
    { date: "2025.12.05", content: "Twitch Stream Helper v1.0.0 公開" },
];
---

<section id="updates" class="bg-slate-900 py-16 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-10">
            <h2
                class="text-2xl font-bold tracking-tight text-white sm:text-3xl"
            >
                Updates
            </h2>
        </div>
        <div class="mx-auto max-w-2xl">
            <ul class="space-y-4">
                {
                    updates.map((update) => (
                        <li class="flex flex-col sm:flex-row gap-2 sm:gap-6 items-start text-left bg-white/5 p-4 rounded-lg">
                            <div class="flex items-center gap-3 shrink-0">
                                <time class="text-sm text-indigo-400 font-mono">
                                    {update.date}
                                </time>
                                {update.type === "blog" ? (
                                    <span class="inline-flex items-center rounded-md bg-pink-400/10 px-2 py-1 text-xs font-medium text-pink-400 ring-1 ring-inset ring-pink-400/20">
                                        Blog
                                    </span>
                                ) : (
                                    <span class="inline-flex items-center rounded-md bg-blue-400/10 px-2 py-1 text-xs font-medium text-blue-400 ring-1 ring-inset ring-blue-400/20">
                                        Update
                                    </span>
                                )}
                            </div>
                            <div class="text-gray-300 text-sm">
                                {update.link ? (
                                    <a
                                        href={update.link}
                                        class="hover:text-white hover:underline decoration-indigo-500 underline-offset-4"
                                    >
                                        {update.content}
                                    </a>
                                ) : (
                                    update.content
                                )}
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

---
const updates = [
    {
        date: "2025.12.09",
        content: "ブログを開設し、拡張機能紹介記事を公開しました。",
        link: "/blog/introducing-my-tools/",
        type: "blog",
    },
    {
        date: "2025.12.08",
        content:
            "「Comment Reader for Twitch (powered by Voicevox)」へ名称を変更しました。",
        link: "/tools/voicevox-comment-reader/",
    },
    {
        date: "2025.12.09",
        content: "ポートフォリオサイトをリニューアルしました",
    },
    { date: "2025.12.05", content: "Twitch Stream Helper v1.0.0 公開" },
];
---

<section id="updates" class="bg-slate-900 py-16 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-10">
            <h2
                class="text-2xl font-bold tracking-tight text-white sm:text-3xl"
            >
                Updates
            </h2>
        </div>
        <div class="mx-auto max-w-2xl">
            <ul class="space-y-4">
                {
                    updates.map((update) => (
                        <li class="flex flex-col sm:flex-row gap-2 sm:gap-6 items-start text-left bg-white/5 p-4 rounded-lg">
                            <time class="text-indigo-400 font-mono font-bold whitespace-nowrap text-sm bg-indigo-500/10 px-2 py-1 rounded">
                                {update.date}
                            </time>

                            {update.link ? (
                                <a
                                    href={update.link}
                                    class="text-gray-300 text-sm sm:text-base hover:text-indigo-400 transition-colors underline decoration-gray-600 hover:decoration-indigo-400"
                                >
                                    {update.content}
                                </a>
                            ) : (
                                <span class="text-gray-300 text-sm sm:text-base">
                                    {update.content}
                                </span>
                            )}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

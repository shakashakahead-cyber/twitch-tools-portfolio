---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const updatesJA = [
    {
        date: "2026.07.23",
        content:
            "「Twitch Stream Helper」を更新しました。タイトル・X告知のテンプレート機能と、Twitchへの反映状態表示を追加しました。",
        link: "/tools/twitch-stream-helper/",
        type: "update",
    },
    {
        date: "2026.07.23",
        content:
            "「Comment Reader for Twitch」を更新しました。返信読み上げ、チャット検出、音声再生の安定性を改善しました。",
        link: "/tools/voicevox-comment-reader/",
        type: "update",
    },
    {
        date: "2026.01.16",
        content: "「OBSで読み上げ音声（VOICEVOX）だけを分離する方法」の記事を公開しました。",
        link: "/blog/separate-voicevox-audio/",
        type: "blog",
    },
    {
        date: "2026.01.06",
        content:
            "「Twitch Stream Helper」のソースコードをGitHubで公開しました。",
        link: "https://github.com/shakashakahead-cyber/twitch-stream-helper",
        type: "release",
    },
    {
        date: "2025.12.28",
        content: "「クリップ抽出くん」の紹介記事を公開しました。",
        link: "/blog/release-clip-extractor/",
        type: "blog",
    },
    {
        date: "2025.12.27",
        content:
            "デスクトップアプリ「クリップ抽出くん ベータ」を公開しました。",
        link: "/tools/clip-extractor/",
        type: "release",
    },
    {
        date: "2025.12.12",
        content: "VOICEVOXキャラクター利用規約まとめ記事を公開しました。",
        link: "/blog/voicevox-terms-summary/",
        type: "blog",
    },
    {
        date: "2025.12.09",
        content: "ブログを開設し、拡張機能紹介記事を公開しました。",
        link: "/blog/introducing-my-tools/",
        type: "blog",
    },
    {
        date: "2025.12.08",
        content:
            "「Comment Reader for Twitch (powered by Voicevox)」へ名称を変更しました。",
        link: "/tools/voicevox-comment-reader/",
    },
    {
        date: "2025.12.09",
        content: "サイトをツール中心の構成にリニューアルしました",
    },
    { date: "2025.12.05", content: "Twitch Stream Helper v1.0.0 公開" },
];

const updatesEN = [
    {
        date: "2026.07.23",
        content:
            "Updated Twitch Stream Helper with title and X announcement templates plus clear Twitch update status.",
        link: "/en/tools/twitch-stream-helper/",
        type: "update",
    },
    {
        date: "2026.07.23",
        content:
            "Updated Comment Reader for Twitch with improved reply reading, chat detection, and audio playback reliability.",
        link: "/en/tools/voicevox-comment-reader/",
        type: "update",
    },
    {
        date: "2026.01.16",
        content: "Published a blog post about separating VOICEVOX audio in OBS.",
        link: "/blog/separate-voicevox-audio/",
        type: "blog",
    },
    {
        date: "2026.01.06",
        content: "Published source code of 'Twitch Stream Helper' on GitHub.",
        link: "https://github.com/shakashakahead-cyber/twitch-stream-helper",
        type: "release",
    },
    {
        date: "2025.12.28",
        content: "Published a blog post introducing 'Clip Extractor'.",
        // English version of the blog post doesn't exist yet, so we point to the Japanese one or keep it as is,
        // but for now let's just show the content.
        // Ideally we should have English blog posts.
        // If the link is strictly Japanese content, maybe we shouldn't link it or warn.
        // For now, I'll keep the link but the user should know it's JA content.
        link: "/blog/release-clip-extractor/",
        type: "blog",
    },
    {
        date: "2025.12.27",
        content: "Released desktop app 'Clip Extractor Beta'.",
        link: "/en/tools/clip-extractor/", // Assuming /en/ route exists or will exist. If not, fallback to /tools/
        type: "release",
    },
    {
        date: "2025.12.12",
        content: "Published a summary of VOICEVOX character usage terms.",
        link: "/blog/voicevox-terms-summary/",
        type: "blog",
    },
    {
        date: "2025.12.09",
        content:
            "Launched the blog and published an introduction to extensions.",
        link: "/blog/introducing-my-tools/",
        type: "blog",
    },
    {
        date: "2025.12.08",
        content:
            "Renamed to 'Comment Reader for Twitch (powered by Voicevox)'.",
        link: "/en/tools/voicevox-comment-reader/",
    },
    {
        date: "2025.12.09",
        content: "Refocused the site around tools.",
    },
    { date: "2025.12.05", content: "Twitch Stream Helper v1.0.0 Released" },
];

const updates = lang === "en" ? updatesEN : updatesJA;
---

<section id="updates" class="bg-slate-900 py-16 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-10">
            <h2
                class="text-2xl font-bold tracking-tight text-white sm:text-3xl"
            >
                {t("section.updates")}
            </h2>
        </div>
        <div class="mx-auto max-w-2xl">
            <ul class="space-y-4">
                {
                    updates.map((update) => (
                        <li class="flex flex-col sm:flex-row gap-2 sm:gap-6 items-start text-left bg-white/5 p-4 rounded-lg">
                            <div class="flex items-center gap-3 shrink-0">
                                <time class="text-sm text-indigo-400 font-mono">
                                    {update.date}
                                </time>
                                {update.type === "blog" ? (
                                    <span class="inline-flex items-center rounded-md bg-pink-400/10 px-2 py-1 text-xs font-medium text-pink-400 ring-1 ring-inset ring-pink-400/20">
                                        Blog
                                    </span>
                                ) : update.type === "release" ? (
                                    <span class="inline-flex items-center rounded-md bg-green-400/10 px-2 py-1 text-xs font-medium text-green-400 ring-1 ring-inset ring-green-400/20">
                                        New
                                    </span>
                                ) : (
                                    <span class="inline-flex items-center rounded-md bg-blue-400/10 px-2 py-1 text-xs font-medium text-blue-400 ring-1 ring-inset ring-blue-400/20">
                                        Update
                                    </span>
                                )}
                            </div>
                            <div class="text-gray-300 text-sm">
                                {update.link ? (
                                    <a
                                        href={update.link}
                                        class="hover:text-white hover:underline decoration-indigo-500 underline-offset-4"
                                    >
                                        {update.content}
                                    </a>
                                ) : (
                                    update.content
                                )}
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

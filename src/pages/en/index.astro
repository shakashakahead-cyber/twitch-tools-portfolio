---
import Layout from "../../layouts/Layout.astro";

// Tool data
const extensions = [
    {
        title: "Twitch Stream Helper",
        desc: "Manage tags, stream settings, and social posts all in one place. Save time on your pre-stream routine.",
        link: "/en/tools/twitch-stream-helper",
        storeUrl:
            "https://chromewebstore.google.com/detail/twitch-stream-helper/fonjapihhkafhmjfdpdcgfoghngldmep",
        icon: "🛠️",
        image: "/images/twitch-stream-helper-preview.png",
    },
    {
        title: "Comment Reader (VOICEVOX)",
        desc: "Let Zundamon and friends read your chat aloud. High-quality TTS integration with VOICEVOX.",
        link: "/en/tools/voicevox-comment-reader",
        storeUrl:
            "https://chromewebstore.google.com/detail/eolabmdepbcdcppfdmkibgjffiifndkd?utm_source=item-share-cb",
        icon: "🗣️",
        image: "/images/voicevox-comment-reader-preview.png",
    },
];

const socialLinks = {
    twitch: "https://www.twitch.tv/akatsukizaemon",
    x: "https://x.com/akatsukizaemon",
    email: "shakashakahead@gmail.com",
};

// Tech Stack
const skills = ["C#"];

// Playing Games
const games = ["VALORANT", "Apex Legends", "Shadowverse"];
---

<Layout
    title="Akatsukizaemon Lab | Streamer Tools"
    description="Streamer tools and extensions for Twitch, developed by Akatsukizaemon."
>
    <main class="relative isolate overflow-hidden pt-14">
        <div
            class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
            aria-hidden="true"
        >
            <div
                class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
                style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
            >
            </div>
        </div>

        <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 text-center">
            <div class="mb-8 flex justify-center">
                <div
                    class="relative rounded-full px-3 py-1 text-sm leading-6 text-gray-400 ring-1 ring-white/10 hover:ring-white/20"
                >
                    Freelance Engineer & Streamer
                </div>
            </div>
            <h1
                class="text-4xl font-bold tracking-tight text-white sm:text-6xl mb-6"
            >
                Akatsukizaemon Lab
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-300 max-w-2xl mx-auto">
                A toolbox for streamers, by a streamer.<br />
                Developing extensions to make Twitch streaming more comfortable and
                fun.
            </p>

            <div class="mt-10 flex items-center justify-center gap-x-6">
                <a
                    href="#products"
                    class="text-sm font-semibold leading-6 text-white animate-bounce"
                >
                    Check Tools <span aria-hidden="true">↓</span>
                </a>
            </div>
        </div>
    </main>

    <section id="products" class="bg-slate-800/50 py-24 sm:py-32 relative z-10">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-2xl text-center mb-16">
                <h2
                    class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
                >
                    Developed Extensions
                </h2>
            </div>
            <div
                class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-2"
            >
                {
                    extensions.map((ext) => (
                        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-slate-900 shadow-xl ring-1 ring-white/10 transition-all hover:ring-indigo-500 hover:-translate-y-1">
                            <a
                                href={ext.link}
                                class="relative h-48 overflow-hidden bg-slate-800 block"
                            >
                                <img
                                    src={ext.image}
                                    alt={ext.title}
                                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent" />
                            </a>

                            <div class="flex flex-1 flex-col justify-between p-6">
                                <div>
                                    <a
                                        href={ext.link}
                                        class="flex items-center gap-x-3 text-2xl mb-2 hover:text-indigo-400 transition-colors w-fit"
                                    >
                                        <span>{ext.icon}</span>
                                        <h3 class="font-bold text-white">
                                            {ext.title}
                                        </h3>
                                    </a>
                                    <p class="text-sm leading-6 text-gray-400">
                                        {ext.desc}
                                    </p>
                                </div>

                                <div class="mt-6 flex items-center justify-between gap-4 pt-4 border-t border-white/5">
                                    <a
                                        href={ext.link}
                                        class="text-sm font-semibold text-indigo-400 hover:text-indigo-300 flex items-center gap-1 transition-colors"
                                    >
                                        Details / Usage{" "}
                                        <span aria-hidden="true">&rarr;</span>
                                    </a>
                                    <a
                                        href={ext.storeUrl}
                                        target="_blank"
                                        class="rounded-md bg-white/10 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 transition-colors flex items-center gap-2"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                            class="w-4 h-4 text-indigo-400"
                                        >
                                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                                        </svg>
                                        Store
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section
        id="about"
        class="bg-slate-800 relative isolate overflow-hidden py-24 sm:py-32"
    >
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div
                class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:items-start"
            >
                <div class="w-full max-w-xl lg:shrink-0 xl:max-w-2xl">
                    <h2
                        class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
                    >
                        About Developer
                    </h2>
                    <p class="mt-6 text-lg leading-8 text-gray-300">
                        Freelance Engineer & Twitch Streamer with a background
                        in the JSDF.<br />
                        Living in Nakano, Tokyo with cats, developing with the motto
                        "Solving streaming problems with technology".
                    </p>

                    <div class="mt-8 border-l-2 border-indigo-500 pl-6">
                        <h3 class="text-sm font-semibold text-indigo-400 mb-2">
                            Tech Stack
                        </h3>
                        <div class="flex flex-wrap gap-2">
                            {
                                skills.map((skill) => (
                                    <span class="inline-flex items-center rounded-md bg-indigo-400/10 px-2 py-1 text-xs font-medium text-indigo-400 ring-1 ring-inset ring-indigo-400/30">
                                        {skill}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <div class="mt-6 border-l-2 border-purple-500 pl-6">
                        <h3 class="text-sm font-semibold text-purple-400 mb-2">
                            Playing / Streaming
                        </h3>
                        <p class="text-sm text-gray-400 mb-2">
                            Mainly streaming VALORANT. I also love talking about
                            audio gear and gadgets.
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {
                                games.map((game) => (
                                    <span class="inline-flex items-center rounded-md bg-purple-400/10 px-2 py-1 text-xs font-medium text-purple-400 ring-1 ring-inset ring-purple-400/30">
                                        {game}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <div class="mt-10 flex items-center gap-x-6">
                        <a
                            href={socialLinks.twitch}
                            target="_blank"
                            class="rounded-md bg-[#9146FF] px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#7c2cf5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#9146FF] transition-colors flex items-center gap-2"
                        >
                            <svg
                                class="h-5 w-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    fill-rule="evenodd"
                                    d="M11.64 5.93h1.43v4.28h-1.43m3.93-4.28H17v4.28h-1.43M7 2L3.43 5.57v12.86h4.28V22l3.58-3.57h2.85L20.57 12V2m-1.43 9.29l-2.85 2.85h-2.86l-2.5 2.5v-2.5H7.71V3.43h11.43z"
                                    clip-rule="evenodd"></path></svg
                            >
                            Check Channel on Twitch
                        </a>
                        <a
                            href={socialLinks.x}
                            target="_blank"
                            class="text-sm font-semibold leading-6 text-white hover:text-gray-300"
                        >
                            X (Twitter) <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </div>

                <div class="mt-8 lg:mt-0 flex flex-col gap-8">
                    <!-- Avatar -->
                    <div class="flex justify-center">
                        <div
                            class="relative rounded-full bg-gray-900 p-4 ring-1 ring-white/10 shadow-2xl"
                        >
                            <div
                                class="h-48 w-48 lg:h-56 lg:w-56 rounded-full bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-6xl shadow-inner overflow-hidden relative group"
                            >
                                <img
                                    src="/images/avatar.png"
                                    alt="Akatsukizaemon"
                                    class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-300"
                                />
                            </div>

                            <div
                                class="absolute -bottom-2 -right-2 rounded-xl bg-slate-800 p-3 shadow-lg ring-1 ring-white/10"
                            >
                                <div class="flex items-center gap-x-2">
                                    <span class="relative flex h-3 w-3">
                                        <span
                                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                                        ></span>
                                        <span
                                            class="relative inline-flex rounded-full h-3 w-3 bg-green-500"
                                        ></span>
                                    </span>
                                    <span
                                        class="text-xs font-semibold text-white"
                                        >Accepting Jobs</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Twitch Embed -->
                    <div
                        class="relative w-full aspect-video rounded-xl overflow-hidden shadow-2xl ring-1 ring-auto ring-purple-500/50"
                    >
                        <div id="twitch-embed" class="w-full h-full"></div>
                    </div>
                    <div class="text-center">
                        <a
                            href="https://www.twitch.tv/akatsukizaemon"
                            target="_blank"
                            class="text-xs text-gray-400 hover:text-[#9146FF] transition-colors underline decoration-gray-600 hover:decoration-[#9146FF]"
                        >
                            *If player doesn't load, click here (Go to Twitch)
                        </a>
                    </div>

                    <script is:inline src="https://embed.twitch.tv/embed/v1.js"
                    ></script>
                    <script is:inline>
                        new Twitch.Embed("twitch-embed", {
                            width: "100%",
                            height: "100%",
                            channel: "akatsukizaemon",
                            layout: "video",
                            autoplay: false,
                            parent: [
                                "localhost",
                                "127.0.0.1",
                                "shakashakahead.com",
                            ],
                        });
                    </script>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-slate-900 py-16 sm:py-24 border-t border-white/5">
        <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center">
            <h2
                class="text-2xl font-bold tracking-tight text-white sm:text-3xl"
            >
                Feedback & Contact
            </h2>
            <p class="mt-4 text-gray-300">
                For feature requests or bug reports, feel free to contact me on
                X (Twitter).<br />
                For technical consultation or job requests, please contact via Email.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
                <a
                    href={socialLinks.x}
                    target="_blank"
                    class="rounded-full bg-black px-6 py-3 text-sm font-semibold text-white shadow-sm ring-1 ring-white/20 hover:bg-gray-800 transition-all flex items-center justify-center gap-2"
                >
                    <svg
                        class="h-4 w-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        ><path
                            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                        ></path></svg
                    >
                    Contact on X
                </a>
                <a
                    href={`mailto:${socialLinks.email}`}
                    class="rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-white hover:bg-white/20 transition-all flex items-center justify-center gap-2"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                        ></path>
                    </svg>
                    Send Email
                </a>
            </div>
        </div>
    </section>

    <footer class="bg-slate-950 py-12 border-t border-white/5">
        <div
            class="mx-auto max-w-7xl px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6"
        >
            <div class="flex items-center gap-4">
                <a
                    href="/en/"
                    class="text-white font-bold text-lg hover:text-indigo-400 transition-colors"
                    >Akatsukizaemon Lab</a
                >
                <div class="text-xs text-gray-500">
                    © {new Date().getFullYear()} Akatsukizaemon
                </div>
            </div>

            <div class="flex gap-6">
                <a
                    href={socialLinks.twitch}
                    target="_blank"
                    class="text-gray-400 hover:text-[#9146FF] transition-colors flex items-center gap-2"
                >
                    <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        ><path
                            fill-rule="evenodd"
                            d="M11.64 5.93h1.43v4.28h-1.43m3.93-4.28H17v4.28h-1.43M7 2L3.43 5.57v12.86h4.28V22l3.58-3.57h2.85L20.57 12V2m-1.43 9.29l-2.85 2.85h-2.86l-2.5 2.5v-2.5H7.71V3.43h11.43z"
                            clip-rule="evenodd"></path></svg
                    >
                    Twitch
                </a>
                <a
                    href={socialLinks.x}
                    target="_blank"
                    class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"
                >
                    <svg
                        class="h-5 w-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        ><path
                            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                        ></path></svg
                    >
                    X
                </a>
                <a
                    href={`mailto:${socialLinks.email}`}
                    class="text-gray-400 hover:text-white transition-colors flex items-center gap-2"
                >
                    <svg
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                        ></path>
                    </svg>
                    Email
                </a>
            </div>
        </div>
    </footer>
</Layout>

<style is:global>
    body {
        font-family: "Noto Sans JP", sans-serif;
    }

    /* Markdownページ用のスタイル */
    /* @tailwindcss/typography プラグインを使用するため手動定義は削除 */

    /* Markdownページのコンテナ */
    .markdown-container {
        @apply mx-auto max-w-3xl px-6 py-24;
    }
</style>

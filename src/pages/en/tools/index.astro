---
import Layout from "../../../layouts/Layout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import ToolsSection from "../../../components/ToolsSection.astro";
import { extensions, socialLinks } from "../../../data/siteData";

const toolList = extensions["en"];
---

<Layout
    title="Tools | Akatsukizaemon Lab"
    description="List of Twitch extensions developed by Akatsukizaemon."
>
    <Navigation />

    <main class="relative isolate overflow-hidden pt-14">
        <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8 text-center">
            <h1
                class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-6"
            >
                Developed Tools
            </h1>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto">
                Chrome extensions to make your Twitch streaming more
                comfortable.<br />
                All tools are available for free.
            </p>
        </div>

        <ToolsSection extensions={toolList} />
    </main>


</Layout>

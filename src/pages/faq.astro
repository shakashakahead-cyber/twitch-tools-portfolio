---
import Layout from "../layouts/Layout.astro";

const title = "よくある質問 (FAQ) | Akatsukizaemon Lab";
const description = "暁左衛門 Labの全ツール共通のよくある質問と回答集です。";

const faqGroups = [
  {
    title: "💰 全般",
    items: [
      {
        question: "本当に無料で使えますか？",
        answer: "<strong>はい、現在公開しているツールは無料でお使いいただけます。</strong><br>ツールごとの利用条件や、同梱ソフトウェア・音声ライブラリの規約は各詳細ページでご確認ください。気に入っていただけたら、SNSでのシェアやGitHubでのスターをいただけると励みになります！"
      },
      {
        question: "商用利用（収益化配信など）は可能ですか？",
        answer: "<strong>基本的に可能です。</strong><br>Twitchのアフィリエイト/パートナープログラムによる収益化や、YouTubeでの広告収入を得ているチャンネルでも問題なくご利用いただけます。ただし、VOICEVOXを利用するツールに関しては、各音声ライブラリ（キャラクター）の利用規約に従ってください。"
      },
      {
        question: "Mac版はありますか？",
        answer: "<strong>Chrome拡張機能はMacでも使えます。</strong><br>「Twitch Stream Helper」と「Comment Reader for Twitch」は、Google Chrome等のブラウザが動けばMacでも動作します。「Ichi Browser」はAndroid 14以降のarm64端末向け、「クリップ抽出くん」はWindows向けです。"
      }
    ]
  },
  {
    title: "🌐 Ichi Browser",
    items: [
      {
        question: "どの端末で使えますか？Google Playから入手できますか？",
        answer: "<strong>現在はAndroid 14以降のarm64端末に対応しています。</strong><br>開発途中の先行公開版で、Google Playでは配布していません。<a href=\"/tools/ichi-browser/#download\">Ichi Browserの公式ページ</a>からAPKをダウンロードし、対応条件と既知の問題を確認してからインストールしてください。"
      },
      {
        question: "Ichi Browserを最新版に更新するには？",
        answer: "アプリの「メニュー」→「設定」→「アプリの更新を確認」から最新版を確認し、公式APKを上書きインストールしてください。<strong>更新のためにアンインストールすると、ブックマークや設定を失う場合があります。</strong>"
      },
      {
        question: "ログインや決済がうまく動かないサイトがあります",
        answer: "別窓との連携が必要な認証・決済など、一部のサイトや機能には制限があります。<a href=\"/tools/ichi-browser/#issues\">既知の問題</a>を確認し、解決しない場合は別のブラウザをご利用ください。不具合報告は、アプリ版・Android版・端末名・再現手順を添えて<a href=\"/support/\">サポート窓口</a>へお願いします。"
      }
    ]
  },
  {
    title: "🛠️ トラブルシューティング",
    items: [
      {
        question: "拡張機能が動きません",
        answer: "<strong>以下の手順を試してみてください。</strong><br>1. ブラウザを再起動する<br>2. 拡張機能を一度無効化し、再度有効化する<br>3. Twitchのページをスーパーリロード（Ctrl + F5 / Cmd + Shift + R）する"
      },
      {
        question: "「クリップ抽出くん」で解析が進まない",
        answer: "<strong>FFmpegは正しく配置されていますか？</strong><br>本ソフトの動作にはFFmpegが必要です。<code>ffmpeg.exe</code> がソフトと同じフォルダ、またはシステムのPathが通った場所に配置されているか確認してください。"
      },
      {
        question: "不具合を見つけました",
        answer: "<strong>ぜひご報告ください！</strong><br><a href=\"/support/\">サポートページ</a>から、GitHub IssueまたはX（旧Twitter）へのご連絡をお願いいたします。スクリーンショットや発生手順を添えていただけると、早期解決につながります。パスワード、認証コード、個人情報は掲載しないでください。"
      }
    ]
  }
];

// JSON-LD Schema Generation
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqGroups.flatMap(group => 
    group.items.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  )
};
---

<Layout title={title} description={description}>
    <h1>❓ よくある質問 (FAQ)</h1>
    
    <p>
        当サイトで公開しているツール全般に関する、よくある質問をまとめました。<br>
        各ツールの詳細なFAQについては、それぞれの<a href="/tools/">ツール詳細ページ</a>も併せてご覧ください。
    </p>

    {faqGroups.map((group, index) => (
        <>
            {index > 0 && <hr />}
            <h2>{group.title}</h2>
            {group.items.map(item => (
                <div class="mb-8">
                    <h3>Q. {item.question}</h3>
                    <p>A. <span set:html={item.answer} /></p>
                </div>
            ))}
        </>
    ))}

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>

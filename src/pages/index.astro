---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ContactSection from "../components/ContactSection.astro";
import UpdatesSection from "../components/UpdatesSection.astro";
import {
    socialLinks,
    skills,
    games,
    extensions,
    profile,
} from "../data/siteData";

const currentLang = "ja";
const strings = profile[currentLang];
const toolList = extensions[currentLang];
---

<Layout
    title="暁左衛門 Lab | 配信者向けツール開発"
    description="Twitch配信をより快適に、より楽しく。現役ストリーマー兼エンジニアが開発した便利な拡張機能たち。"
>
    <!-- Navigation -->
    <Navigation />

    <!-- Hero Section -->
    <main class="relative isolate overflow-hidden pt-14">
        <div
            class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
            aria-hidden="true"
        >
            <div
                class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
                style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
            >
            </div>
        </div>

        <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 text-center">
            <div class="mb-8 flex justify-center">
                <div
                    class="relative rounded-full px-3 py-1 text-sm leading-6 text-gray-400 ring-1 ring-white/10 hover:ring-white/20"
                >
                    {strings.role}
                </div>
            </div>
            <h1
                class="text-4xl font-bold tracking-tight text-white sm:text-6xl mb-6"
            >
                暁左衛門 Lab
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-300 max-w-2xl mx-auto">
                配信者のための、配信者によるツールボックス。<br />
                Twitch配信をより快適に、より楽しくするための拡張機能を開発・公開しています。
            </p>

            <div
                class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-6"
            >
                <a
                    href="/tools/"
                    class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-colors"
                >
                    拡張機能一覧を見る
                </a>
                <a
                    href="/blog/"
                    class="text-sm font-semibold leading-6 text-white hover:text-indigo-300 transition-colors"
                >
                    配信の裏話ブログを読む <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </main>

    <!-- Tools Section (Digest) -->
    <section class="bg-slate-800/50 py-16 relative z-10">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="text-center mb-10">
                <h2 class="text-2xl font-bold tracking-tight text-white mb-4">
                    Developed Extensions
                </h2>
                <a
                    href="/tools/"
                    class="text-indigo-400 hover:text-indigo-300 text-sm font-semibold"
                >
                    すべてのツールを見る <span aria-hidden="true">→</span>
                </a>
            </div>

            <!-- 簡易表示のためcomponents/ToolsSectionをそのまま使うが、数は今後制限するかも -->
            <div
                class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-2"
            >
                {
                    toolList.map((ext) => (
                        // 簡易表示としてToolCardの一部を再利用、あるいはそのまま表示
                        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-slate-900 shadow-xl ring-1 ring-white/10 transition-all hover:ring-indigo-500 hover:-translate-y-1">
                            <a
                                href={ext.link}
                                class="relative h-80 overflow-hidden bg-slate-800 block"
                            >
                                <img
                                    src={ext.image}
                                    alt={ext.title}
                                    class="absolute inset-0 h-full w-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent" />
                            </a>
                            <div class="p-6 flex flex-col flex-1">
                                <a
                                    href={ext.link}
                                    class="flex items-center gap-x-3 text-lg font-bold text-white mb-2 hover:text-indigo-400"
                                >
                                    <span>{ext.icon}</span>
                                    {ext.title}
                                </a>
                                {ext.badge && (
                                    <div class="mb-2">
                                        <span class="inline-block bg-indigo-500 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">
                                            {ext.badge}
                                        </span>
                                    </div>
                                )}
                                <p class="text-sm text-gray-400 line-clamp-2 mb-4">
                                    {ext.desc}
                                </p>

                                <a
                                    href={ext.link}
                                    class="mt-auto text-sm font-semibold text-indigo-400 hover:text-indigo-300"
                                >
                                    詳細を見る{" "}
                                    <span aria-hidden="true">&rarr;</span>
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- About Section (Digest) -->
    <section class="bg-slate-800 relative isolate overflow-hidden py-16">
        <div
            class="mx-auto max-w-7xl px-6 lg:px-8 lg:flex lg:items-center lg:justify-between lg:gap-16"
        >
            <div class="max-w-xl">
                <h2
                    class="text-2xl font-bold tracking-tight text-white sm:text-3xl mb-4"
                >
                    About Developer
                </h2>
                <p class="text-gray-300 mb-6">
                    {strings.description}
                </p>
                <div class="flex items-center gap-4">
                    <a
                        href="/about/"
                        class="text-sm font-semibold text-indigo-400 hover:text-indigo-300"
                    >
                        元自衛官の経歴や、お仕事の依頼はこちら <span
                            aria-hidden="true">→</span
                        >
                    </a>
                </div>
            </div>
            <!-- 簡易AboutなのでTwitch Embedだけ置く -->
            <div class="mt-10 lg:mt-0 w-full max-w-md lg:shrink-0">
                <div
                    class="relative w-full aspect-video rounded-xl overflow-hidden shadow-lg ring-1 ring-white/10 bg-slate-900"
                >
                    <!-- 常に読み込むと重いのでリンクにするか、画像にする -->
                    <div
                        class="flex items-center justify-center h-full flex-col p-6 text-center"
                    >
                        <p class="text-white font-bold mb-2">
                            Akatsukizaemon on Twitch
                        </p>
                        <a
                            href={socialLinks.twitch}
                            target="_blank"
                            class="rounded-md bg-[#9146FF] px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#7c2cf5] transition-colors"
                        >
                            Twitchチャンネルを見る
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Updates Section -->
    <UpdatesSection />

    <!-- Contact Section -->
    <ContactSection socialLinks={socialLinks} />

    <!-- Footer -->
    <Footer socialLinks={socialLinks} />
</Layout>

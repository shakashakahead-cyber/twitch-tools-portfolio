---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ToolsSection from "../components/ToolsSection.astro";
import AboutSection from "../components/AboutSection.astro";
import ContactSection from "../components/ContactSection.astro";
import UpdatesSection from "../components/UpdatesSection.astro";

// ツール一覧データ
const extensions = [
    {
        title: "Twitch Stream Helper",
        desc: "タグ管理・配信設定・SNS告知をこれひとつで。配信準備の時間を短縮します。",
        link: "/tools/twitch-stream-helper/",
        storeUrl:
            "https://chromewebstore.google.com/detail/twitch-stream-helper/fonjapihhkafhmjfdpdcgfoghngldmep",
        icon: "🛠️",
        image: "/images/twitch-stream-helper-preview.png",
    },
    {
        title: "Comment Reader (VOICEVOX)",
        desc: "ずんだもん達がコメントを読み上げ。VOICEVOX連携で高品質な音声読み上げを実現。",
        link: "/tools/voicevox-comment-reader/",
        storeUrl:
            "https://chromewebstore.google.com/detail/eolabmdepbcdcppfdmkibgjffiifndkd?utm_source=item-share-cb",
        icon: "🗣️",
        image: "/images/voicevox-comment-reader-preview.png",
    },
];

const socialLinks = {
    twitch: "https://www.twitch.tv/akatsukizaemon",
    x: "https://x.com/akatsukizaemon",
    email: "shakashakahead@gmail.com",
};

// 技術スタック
const skills = ["C#"];

// プレイ中のゲーム
const games = ["VALORANT", "Apex Legends", "Shadowverse"];
---

<Layout
    title="暁左衛門 Lab | Streamer Tools"
    description="現役配信者・暁左衛門が開発するTwitch配信効率化ツール・拡張機能のポートフォリオサイト。"
>
    <!-- Navigation -->
    <Navigation />

    <!-- Hero Section -->
    <main class="relative isolate overflow-hidden pt-14">
        <div
            class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
            aria-hidden="true"
        >
            <div
                class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
                style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
            >
            </div>
        </div>

        <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 text-center">
            <div class="mb-8 flex justify-center">
                <div
                    class="relative rounded-full px-3 py-1 text-sm leading-6 text-gray-400 ring-1 ring-white/10 hover:ring-white/20"
                >
                    Freelance Engineer & Streamer
                </div>
            </div>
            <h1
                class="text-4xl font-bold tracking-tight text-white sm:text-6xl mb-6"
            >
                Akatsukizaemon Lab
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-300 max-w-2xl mx-auto">
                現役配信者が作る、配信者のためのツールボックス。<br />
                Twitch配信をより快適に、より楽しくするための拡張機能を開発・公開しています。
            </p>

            <div class="mt-10 flex items-center justify-center gap-x-6">
                <a
                    href="#products"
                    class="text-sm font-semibold leading-6 text-white animate-bounce"
                >
                    Check Tools <span aria-hidden="true">↓</span>
                </a>
            </div>
        </div>
    </main>

    <!-- Tools Section -->
    <ToolsSection extensions={extensions} />

    <!-- Updates Section (Placeholder) -->
    <UpdatesSection />

    <!-- About Section -->
    <AboutSection skills={skills} games={games} socialLinks={socialLinks} />

    <!-- Contact Section -->
    <ContactSection socialLinks={socialLinks} />

    <!-- Footer -->
    <Footer socialLinks={socialLinks} />
</Layout>

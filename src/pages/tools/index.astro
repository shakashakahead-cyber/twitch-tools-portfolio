---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ToolsSection from "../../components/ToolsSection.astro";
import { extensions, desktopApps, socialLinks } from "../../data/siteData";

const toolList = extensions["ja"];
const desktopAppList = desktopApps["ja"];
---

<Layout
    title="ツール一覧 | 暁左衛門 Lab"
    description="暁左衛門が開発したTwitch配信向け拡張機能の一覧です。"
>
    <Navigation />

    <main class="relative isolate overflow-hidden pt-14">
        <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8 text-center">
            <h1
                class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-6"
            >
                Developed Tools
            </h1>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto">
                Twitch配信をより快適にするためのツールたち。<br />
                すべて無料でご利用いただけます。
            </p>
        </div>

        <ToolsSection extensions={toolList} />

        <!-- Desktop Apps Section -->
        {
            desktopAppList.length > 0 && (
                <section class="bg-slate-900 py-24 sm:py-32 relative z-10">
                    <div class="mx-auto max-w-7xl px-6 lg:px-8">
                        <div class="mx-auto max-w-2xl text-center mb-16">
                            <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
                                Desktop Applications
                            </h2>
                            <p class="mt-4 text-gray-400">
                                Windows向けデスクトップアプリ
                            </p>
                        </div>
                        <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 lg:mx-0 lg:max-w-none lg:grid-cols-2">
                            {desktopAppList.map((app) => (
                                <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-slate-800 shadow-xl ring-1 ring-white/10 transition-all hover:ring-indigo-500 hover:-translate-y-1">
                                    <a
                                        href={app.link}
                                        class="relative h-80 overflow-hidden bg-slate-700 block"
                                    >
                                        <img
                                            src={app.image}
                                            alt={app.title}
                                            class="absolute inset-0 h-full w-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                                        />
                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent" />
                                        <div class="absolute top-4 right-4 flex items-center gap-2">
                                            <span class="inline-flex items-center gap-1 bg-slate-900/80 text-gray-300 text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="w-3 h-3"
                                                    viewBox="0 0 24 24"
                                                    fill="currentColor"
                                                >
                                                    <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801" />
                                                </svg>
                                                {app.platform}
                                            </span>
                                        </div>
                                    </a>
                                    <div class="p-6 flex flex-col flex-1">
                                        <a
                                            href={app.link}
                                            class="flex items-center gap-x-3 text-lg font-bold text-white mb-2 hover:text-indigo-400"
                                        >
                                            <span>{app.icon}</span>
                                            {app.title}
                                        </a>
                                        {app.badge && (
                                            <div class="mb-2">
                                                <span class="inline-block bg-purple-500 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">
                                                    {app.badge}
                                                </span>
                                            </div>
                                        )}
                                        <p class="text-sm text-gray-400 line-clamp-2 mb-4">
                                            {app.desc}
                                        </p>
                                        {app.features && (
                                            <ul class="mb-4 space-y-1">
                                                {app.features
                                                    .slice(0, 2)
                                                    .map((feature) => (
                                                        <li class="text-xs text-gray-400 flex items-start gap-2">
                                                            <span class="text-indigo-500 mt-0.5">
                                                                •
                                                            </span>
                                                            {feature}
                                                        </li>
                                                    ))}
                                            </ul>
                                        )}
                                        <div class="mt-auto pt-4 border-t border-white/5 flex items-center justify-between gap-4">
                                            <a
                                                href={app.link}
                                                class="text-sm font-semibold text-indigo-400 hover:text-indigo-300 flex items-center gap-1"
                                            >
                                                詳細を見る{" "}
                                                <span aria-hidden="true">
                                                    &rarr;
                                                </span>
                                            </a>
                                            <div class="flex items-center gap-2">
                                                <span class="text-xs text-gray-500">
                                                    {app.fileSize}
                                                </span>
                                                <a
                                                    href={app.downloadUrl}
                                                    target="_blank"
                                                    class="rounded-md bg-gradient-to-r from-indigo-600 to-purple-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:from-indigo-500 hover:to-purple-500 transition-colors flex items-center gap-2"
                                                >
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke-width="2"
                                                        stroke="currentColor"
                                                        class="w-4 h-4"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
                                                        />
                                                    </svg>
                                                    ダウンロード
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </section>
            )
        }
    </main>

    <Footer socialLinks={socialLinks} />
</Layout>

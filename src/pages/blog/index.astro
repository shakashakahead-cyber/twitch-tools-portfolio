---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";

const posts = await Astro.glob("./*.md");
const entries = [
    ...posts.map((post) => ({
        url: post.url,
        title: post.frontmatter.title,
        description: post.frontmatter.description,
        pubDate: post.frontmatter.pubDate,
        type: "Article",
    })),
    {
        url: "/tools/ichi-browser/guide/",
        title: "1タブブラウザとは？Ichi Browserの使い方・設定ガイド",
        description:
            "1タブの仕組み、片手操作、広告ブロック、端末内翻訳、ホームとブックマークの使い分けを紹介します。",
        pubDate: "2026-09-16",
        type: "Guide",
    },
];

// 日付の新しい順にソート
entries.sort(
    (a, b) =>
        new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf(),
);

---

<Layout
    title="ブログ・ガイド | 暁左衛門 Lab"
    description="ツールの使い方ガイド、開発日記、技術Tips、配信ノウハウなどを発信します。"
>
    <Navigation />

    <main class="pt-24 pb-16 lg:pt-32 lg:pb-24 bg-slate-900 min-h-screen">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <div class="mx-auto max-w-2xl text-center mb-16">
                <h1
                    class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
                >
                    Blog & Guides
                </h1>
                <p class="mt-4 text-lg text-gray-400">
                    ツールの使い方や、開発・配信に役立つ情報をお届けします。
                </p>
            </div>

            <div class="grid grid-cols-1 gap-8">
                {
                    entries.map((entry) => (
                        <article class="flex flex-col items-start justify-between bg-slate-800/50 p-6 rounded-2xl hover:bg-slate-800 transition-colors ring-1 ring-white/10">
                            <div class="flex items-center gap-x-4 text-xs">
                                <time
                                    datetime={entry.pubDate}
                                    class="text-gray-400 font-mono"
                                >
                                    {new Date(entry.pubDate).toLocaleDateString("ja-JP")}
                                </time>
                                <span
                                    class:list={[
                                        "relative z-10 rounded-full px-3 py-1.5 font-medium ring-1 ring-inset",
                                        entry.type === "Guide"
                                            ? "bg-emerald-500/10 text-emerald-300 ring-emerald-500/20"
                                            : "bg-indigo-500/10 text-indigo-400 ring-indigo-500/20",
                                    ]}
                                >
                                    {entry.type}
                                </span>
                            </div>
                            <div class="group relative">
                                <h3 class="mt-3 text-xl font-semibold leading-6 text-white group-hover:text-indigo-400 transition-colors">
                                    <a href={entry.url}>
                                        <span class="absolute inset-0" />
                                        {entry.title}
                                    </a>
                                </h3>
                                <p class="mt-5 line-clamp-3 text-sm leading-6 text-gray-400">
                                    {entry.description}
                                </p>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </main>


</Layout>
